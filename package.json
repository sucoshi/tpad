{
	"name": "tpad",
	"version": "0.0.0",
	"license": "MIT",
	"bin": {
		"tpad": "bin/cli.js",
		"tpad-mcp": "bin/mcp.js"
	},
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"prepare": "npm run build"
	},
	"files": [
		"dist",
		"bin"
	],
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@tiptap/extension-placeholder": "^3.23.4",
		"@tiptap/extension-table": "^3.23.4",
		"@tiptap/extension-table-cell": "^3.23.4",
		"@tiptap/extension-table-header": "^3.23.4",
		"@tiptap/extension-table-row": "^3.23.4",
		"@tiptap/extension-task-item": "^3.23.4",
		"@tiptap/extension-task-list": "^3.23.4",
		"@tiptap/react": "^3.23.4",
		"@tiptap/starter-kit": "^3.23.4",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"open": "^11.0.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tiptap-markdown": "^0.9.0"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--loader=ts-node/esm"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config",
	"packageManager": "npm@11.12.1+sha512.cdca14b85d647b3192028d02aadbe82d75f79a446aceea9874be98e6d768f20ebd3555770a48d0e9906106007877bbc690f715e9372f2e2dc644a3c3157fb14c",
	"devDependencies": {
		"@vitejs/plugin-react": "^6.0.1",
		"vite": "^8.0.12"
	}
}
